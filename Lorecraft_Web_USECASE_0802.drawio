        <mxCell id="3bEfPHXlVL3sKCdqQwz2-12" value="작성한 자신의 덱리스트를 첨부" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-800" y="3540" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3bEfPHXlVL3sKCdqQwz2-14" value="덱 추출 및 통계보기&lt;br&gt;-관리자 대시보드-" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
